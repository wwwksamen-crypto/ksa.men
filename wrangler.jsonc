{
 "name":"ksa-men-prod-app","main":"server/index.ts","compatibility_date":"2026-10-01","compatibility_flags":["nodejs_compat"],"account_id":"c4bed103a44f2fc99adeb96126a0a9ff","workers_dev":false,
 "assets":{"directory":"./dist/client","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
 "vars":{"ROOT_DOMAIN":"ksa.men","OWNER_EMAIL":"www.ksa.men@gmail.com"},
 // Cloudflare does not support the requested "me" location hint for D1 or R2,
 // and location/jurisdiction is fixed at resource creation. Do not claim a move
 // for these existing bindings; see docs/data-residency-20261031.md before any migration.
 "d1_databases":[{"binding":"DB","database_name":"ksa-men-prod-db","database_id":"dd006d15-8b4c-4469-9809-af08cbb42ad4","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"MEDIA","bucket_name":"ksa-men-prod-media"}],
 "ai":{"binding":"AI"},
 "triggers":{"crons":["0 */6 * * *"]},"observability":{"enabled":true}
}
