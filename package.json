{
  "name": "ksa-men",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 3000",
    "build": "vite build && esbuild server/index.ts --bundle --format=esm --platform=browser --external:cloudflare:* --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "hono": "^4.9.0",
    "zod": "^4.1.0",
    "qrcode": "^1.5.4",
    "lucide-react": "^0.468.0",
    "pdfmake": "^0.2.20",
    "html-to-image": "^1.11.13",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "wrangler": "^4.50.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/pdfmake": "^0.2.11",
    "@types/node": "^22.0.0"
  }
}
